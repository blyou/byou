{
  "name": "@blyou/byou",
  "version": "0.0.0",
  "description": "byou — a minimal reactive UI framework",
  "keywords": [
    "byou",
    "dom",
    "fine-grained",
    "reactive",
    "router",
    "signals",
    "typescript",
    "ui",
    "ui-framework",
    "vanilla"
  ],
  "homepage": "https://github.com/blyou/byou#readme",
  "bugs": {
    "url": "https://github.com/blyou/byou/issues"
  },
  "license": "MIT",
  "author": "blyou <youbolincode@163.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blyou/byou.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "unpkg": "./dist/index.iife.js",
  "jsdelivr": "./dist/index.iife.js",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "play": "vite",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "oxfmt src/",
    "git:hooks": "pnpm simple-git-hooks",
    "taze": "pnpx taze -I"
  },
  "dependencies": {
    "alien-signals": "^3.2.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@types/node": "^26.4.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "@vue/eslint-config-typescript": "^14.9.0",
    "bumpp": "^12.2.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.80.0",
    "eslint-plugin-vue": "^10.10.0",
    "lint-staged": "^17.4.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "simple-git-hooks": "^2.14.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "inlinedDependencies": {
    "alien-signals": "3.2.1"
  }
}
